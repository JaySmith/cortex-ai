__pycache__/
*.pyc
.playwright-mcp/
.venv/
*.egg-info/
node_modules/
dist/
build/
.DS_Store
*.swp
*.swo
*~
.env
__MACOSX/

# Live config belongs at <vault>/_sync/cortex.yaml, never in the repo
cortex.yaml

# example-vault/_sync/ is generated by `cortex install` (config + encoded output);
# it carries machine-specific paths and is regenerated on clone — never commit it.
example-vault/_sync/

# graphify build artifacts. graph.json/GRAPH_REPORT.md/graph.html/manifest.json/
# cost.json/.graphify_labels.json are portable and may be committed; the items
# below carry machine-specific absolute paths (/Users/...) or are a local cache,
# so they must never be committed. Regenerated on the next graphify run.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/

# uv lockfile: local tool artifact, deps are pinned loosely in pyproject.toml
uv.lock
